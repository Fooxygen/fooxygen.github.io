---
import '../styles/global.css';
import '../styles/markdown.css';
import Header  from '../components/header.astro';
import Footer  from '../components/footer.astro';
import Profile from '../components/profile.astro';
import Tags    from '../components/tags.astro';

interface Props {
    title?: string;
}

const {
    title = "Fooxygen's Space"
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title} | Fooxygen's Home</title>
    </head>
    <body>
        <Header/>
        <section class="banner"></section>
        <main>
            <div class="container">
                <a
                    href="https://www.pixiv.net/artworks/106667556"
                    title="Open this artwork on Pixiv"
                    class="btn_label tag banner_detail">
                    Kugigigi | ぼっち電車
                </a>
                <div class="grid_columns">
                    <div class="grid_rows">
                        <Profile/>
                        <Tags/>
                    </div>
                    <div class="content">
                        <slot/>
                    </div>
                </div>
            </div>
        </main>
        <Footer/>
    </body>
</html>

<style>
    main {
        width: 100%;
        position: relative;
        margin-top: -5.5rem;
    }

    .container {
        width: var(--content_width);
        margin: 0 auto;
    }

    .banner {
		background: url('https://cdn.jsdelivr.net/gh/Fooxygen/fooxygen.github.io@main/public/images/banner.jpg') bottom / cover;
		min-width: 100vw;
		aspect-ratio: 2.85 / 1;

        animation: banner-blur linear both;
        animation-timeline: scroll();
        animation-range: 0vh 40vh;
	}
    .banner_detail {
        display: block;
        width: fit-content;
        margin-left: auto;
        
        animation: banner-blur linear both;
        animation-timeline: scroll();
        animation-range: 0vh 40vh;
    }
    @keyframes banner-blur {
        to { filter: blur(4px); }
    }

    .grid_rows {
        display: grid;
        gap: 1rem;
        align-self: start;
    }

    .grid_columns {
        display: grid;
        grid-template-columns: 1fr 3fr;
        gap: 2rem;
    }

    .content {
        padding: 1rem;
        min-width: 0;
    }

</style>
