---
import { profile } from '../config';
---

<profile>
    <img src={profile.avatar} class="avatar">
    <div class="text_label_ultrathick name">Fooxygen</div>
    <div class="text_label_thin signature">Bravely forward to pursue my dream.</div>
</profile>
    
<style>
    profile {
        padding: 0.5rem;

        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .avatar {
        display: block;
        width: 100%;
        aspect-ratio: 1;
        background: var(--foreground);
        border-radius: 50%;
        padding: 0.5rem;
    }

    .signature {
        text-align: center;
    }
</style>
