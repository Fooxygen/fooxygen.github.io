</aside>
    
<style>
    aside {
        padding: 0.5rem;

        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .avatar {
        display: block;
        width: 100%;
        aspect-ratio: 1;
        background: var(--foreground);
        border-radius: 50%;
        padding: 0.5rem;
    }

    .name {
        padding-bottom: 0.5rem;
    }

    .detail {
        width: 100%;
        border-radius: var(--radius);
        background: var(--foreground);
        padding: 1.2rem;
    }
</style>
