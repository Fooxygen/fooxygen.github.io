---
import { profile } from '../config';
import '../styles/global.css';
---

<aside>
    <img src={profile.avatar} class="avatar">
    <div class="text_label name">Fooxygen</div>
    <div class="detail">
        <h1>Hello</h1>
        <h2>Hello</h2>
        <h3>Hello</h3>
        <h4>Hello</h4>
