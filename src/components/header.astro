---
import { Icon }  from 'astro-icon/components';
---

<header>
    <nav>
        <div class="container">
            <div><a href="/" class="btn_label text_label brand">Fooxygen's Space</a></div>
            <div class="group">
                <a href="/" class="btn_label text_label">Home</a>
                <a href="/blogs" class="btn_label text_label">Blogs</a>
            </div>
            <div class="group">
                <a href="https://github.com/Fooxygen" class="group_external_elem textcolor">
                    <Icon name="simple-icons:github" class="icon" />
                </a>
            </div>
        </div>
    </nav>
</header>

<style>
    nav {
        z-index: 9999;
        position: fixed;
        top: 0;
        left: 50%;
        transform: translate(-50%, 0);
        width: var(--content_width);
        padding: 1rem 1.6rem;

        background: var(--background);
        border-radius: var(--radius_bottom);

        transform: translate(-50%, 0);
        transition:
            top 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
            padding 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
            width 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
            border-radius 0.45s ease,
            background 0.45s ease,
            box-shadow 0.45s ease,
            backdrop-filter 0.45s ease;
    }
    nav.island {
        top: 1.1rem;
        width: calc(var(--content_width) + 4rem);
        padding: 0.7rem 1.6rem;
        border-radius: var(--radius);

        background: color-mix(in srgb, var(--background) 62%, transparent);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        backdrop-filter: blur(16px) saturate(180%);
        box-shadow:
            inset 0 0 0 1px color-mix(in srgb, var(--brand) 70%, transparent),
            0 8px 32px rgba(0, 0, 0, 0.35);
    }

    .container {
        width: 90%;
        height: 100%;
        
        margin: 0 auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 1rem;
    }

    .group {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 2rem;
    }

    .group_external_elem {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .brand {
        color: var(--brand);
    }
</style>

<script>
    const n = document.querySelector('nav')!;
    let lastY = scrollY;
    let lastDir = 0;
    addEventListener('scroll', () => {
        const y = scrollY;
        const dir = y > lastY ? 1 : y < lastY ? -1 : 0;
        if (dir !== 0 && dir !== lastDir) n.classList.toggle('island', dir === 1);
        if (dir !== 0) lastDir = dir;
        lastY = y;
    }, { passive: true });
</script>
