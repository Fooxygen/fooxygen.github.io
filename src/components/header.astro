---
import { Icon }  from 'astro-icon/components';
---

<header>
    <nav>
        <div class="container">
            <div><a href="/" class="btn text_label brand">Fooxygen's Space</a></div>
            <div class="group">
                <a href="/" class="btn text_label">Home</a>
            </div>
            <div class="group">
                <a href="https://github.com/Fooxygen" class="group_external_elem">
                    <Icon name="simple-icons:github" class="icon" />
                </a>
            </div>
        </div>
    </nav>
</header>

<style>
    nav {
        z-index: 9999;
        position: fixed;
        top: 0;
        left: 50%;
        transform: translate(-50%, 0);
        width: var(--content_width);
        padding: 1rem 1.6rem;

        background: var(--background);
        border-radius: var(--radius_bottom);

        transform: translate(-50%, 0);
        transition: transform 0.3s ease;
    }
    nav.hidden {
        transition: transform 0.15s ease;
        transform: translate(-50%, -120%);
    }

    .container {
        width: 90%;
        height: 100%;
        
        margin: 0 auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 1rem;
    }

    .group {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .group_external_elem {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .brand {
        color: var(--brand);
    }
</style>

<script>
    const dist = 75;
    const n = document.querySelector('nav')!;
    let lastY = scrollY;
    addEventListener('scroll', () => {
        const y = scrollY;
        n.classList.toggle('hidden', y >= dist && y > lastY);
        lastY = y;
    }, { passive: true });
</script>
