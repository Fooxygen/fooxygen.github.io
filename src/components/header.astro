---
---

<header>
    <nav>
        <div><a href="/" class="btn brand">Fooxygen's Space</a></div>
        <div class="container">
            <a href="/" class="btn">Home</a>
        </div>
        <div class="container">
            <a href="https://github.com/Fooxygen">
                <img src="/icons/github.svg" alt="Github" class="container_external">
            </a>
        </div>
    </nav>
</header>

<style>
    nav {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 67vw;
        height: 6vh;
        padding: 0.5rem 3rem 0.6rem 3rem;
        border-radius: 0 0 1.25rem 1.25rem;

        background: var(--bg);
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 1rem;
    }

    .container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .container_external {
        display: block;
        height: 1.75rem;
        width: auto;
    }

    .brand {
        color: var(--brand);
    }
</style>
